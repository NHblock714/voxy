#version 460 core

#import <voxy:util/depthutils.glsl>

//One workgroup folds a 64x64 tile of the source level into up to six coarser levels. The folds
//above the per-thread 4x4 go through shared memory: nothing here depends on how the driver maps
//invocations onto subgroups, so the chain is exact on every GL 4.6 implementation.
//
//Level 0 of the chain is produced by blit.fsh, which the draw chain re-runs for EVERY level while
//this shader only ever reads its output. That is only equivalent because blit.fsh's FAR/NEAR
//"hole patch" is value-neutral (FAR absorbs the farthest-reduction); should it ever stop being
//so, the two chains diverge above level 0.
layout(local_size_x=256) in;

const uint spread[64] = {
    0x11100100, 0x13120302, 0x31302120, 0x33322322, 0x15140504, 0x17160706, 0x35342524, 0x37362726,
    0x51504140, 0x53524342, 0x71706160, 0x73726362, 0x55544544, 0x57564746, 0x75746564, 0x77766766,
    0x19180908, 0x1b1a0b0a, 0x39382928, 0x3b3a2b2a, 0x1d1c0d0c, 0x1f1e0f0e, 0x3d3c2d2c, 0x3f3e2f2e,
    0x59584948, 0x5b5a4b4a, 0x79786968, 0x7b7a6b6a, 0x5d5c4d4c, 0x5f5e4f4e, 0x7d7c6d6c, 0x7f7e6f6e,
    0x91908180, 0x93928382, 0xb1b0a1a0, 0xb3b2a3a2, 0x95948584, 0x97968786, 0xb5b4a5a4, 0xb7b6a7a6,
    0xd1d0c1c0, 0xd3d2c3c2, 0xf1f0e1e0, 0xf3f2e3e2, 0xd5d4c5c4, 0xd7d6c7c6, 0xf5f4e5e4, 0xf7f6e7e6,
    0x99988988, 0x9b9a8b8a, 0xb9b8a9a8, 0xbbbaabaa, 0x9d9c8d8c, 0x9f9e8f8e, 0xbdbcadac, 0xbfbeafae,
    0xd9d8c9c8, 0xdbdacbca, 0xf9f8e9e8, 0xfbfaebea, 0xdddccdcc, 0xdfdecfce, 0xfdfcedec, 0xfffeefee
};

uint swizzleId(uint id) {
    //z-order over the 16x16 thread grid: 4 consecutive ids form a 2x2 block, 16 a 4x4 block
    return bitfieldExtract(spread[id>>2], (int(id)&3)*8, 8);
}

layout(location = 0) uniform int srcLevel;
//Levels written by this dispatch (1..6); image units above it are unbound
layout(location = 1) uniform int outLevels;

layout(binding = 0) uniform sampler2D src;
layout(binding = 1, r32f) uniform restrict writeonly image2D mip_1;
layout(binding = 2, r32f) uniform restrict writeonly image2D mip_2;
layout(binding = 3, r32f) uniform restrict writeonly image2D mip_3;
layout(binding = 4, r32f) uniform restrict writeonly image2D mip_4;
layout(binding = 5, r32f) uniform restrict writeonly image2D mip_5;
layout(binding = 6, r32f) uniform restrict writeonly image2D mip_6;

ivec2 srcMax;
vec2 invSrcSize;

//The 2x2 source block whose top-left texel is p. Clamping duplicates the edge texel wherever the
//footprint runs past the source level (a level narrower than the tile, or already 1 texel
//high/wide) - the same texels a CLAMP_TO_EDGE gather reads. A duplicate never changes a min/max,
//so missing texels are ignored rather than counted as far. Gather has no level argument and reads
//the base level, so it serves the level-0 dispatch only; the sizes are powers of two, so the uv of
//the block's shared corner is exact.
vec4 fetch2x2(ivec2 p) {
    if (srcLevel == 0) {
        return textureGather(src, vec2(p + 1) * invSrcSize, 0);
    }
    return vec4(
        texelFetch(src, min(p, srcMax), srcLevel).r,
        texelFetch(src, min(p + ivec2(1, 0), srcMax), srcLevel).r,
        texelFetch(src, min(p + ivec2(0, 1), srcMax), srcLevel).r,
        texelFetch(src, min(p + ivec2(1, 1), srcMax), srcLevel).r);
}

float reduce2x2(ivec2 pos) {//w.r.t mip_1
    vec4 d = fetch2x2(pos*2);
    float ret = REDUCTION(REDUCTION(d.x, d.y), REDUCTION(d.z, d.w));
    imageStore(mip_1, pos, vec4(ret));
    return ret;
}

float reduce4x4(ivec2 pos) {//w.r.t mip_2
    ivec2 p = pos*2;
    float ret = REDUCTION(REDUCTION(reduce2x2(p), reduce2x2(p+ivec2(1,0))), REDUCTION(reduce2x2(p+ivec2(0,1)), reduce2x2(p+ivec2(1,1))));
    if (outLevels >= 2) {
        imageStore(mip_2, pos, vec4(ret));
    }
    return ret;
}

//Stores whose coordinates fall outside a level are dropped by GL, which is what lets a tile
//larger than the source level run with every thread active (the folds below need that). The
//shared arrays hold the tile's mip_2 / mip_3 / mip_4 texels in z-order, so every fold reads four
//consecutive entries. Only the image stores are gated by outLevels - the folds and shared writes
//run unconditionally so each barrier() sits in uniform control flow.
shared float l2[256];
shared float l3[64];
shared float l4[16];
void main() {
    srcMax = textureSize(src, srcLevel) - 1;
    invSrcSize = 1.0f / vec2(srcMax + 1);
    uint lid = gl_LocalInvocationID.x;
    uint id = swizzleId(lid);
    ivec2 pos = ivec2(gl_WorkGroupID.xy)*16 + ivec2(id&0xFu, id>>4);//w.r.t mip_2
    l2[lid] = reduce4x4(pos);
    barrier();

    if ((lid&3u) == 0u) {
        float r = REDUCTION(REDUCTION(l2[lid], l2[lid+1u]), REDUCTION(l2[lid+2u], l2[lid+3u]));
        if (outLevels >= 3) {
            imageStore(mip_3, pos>>1, vec4(r));
        }
        l3[lid>>2] = r;
    }
    barrier();

    if ((lid&15u) == 0u) {
        uint i = lid>>2;
        float r = REDUCTION(REDUCTION(l3[i], l3[i+1u]), REDUCTION(l3[i+2u], l3[i+3u]));
        if (outLevels >= 4) {
            imageStore(mip_4, pos>>2, vec4(r));
        }
        l4[lid>>4] = r;
    }
    barrier();

    if (lid >= 4u) {
        return;
    }
    uint i = lid*4u;
    float value = REDUCTION(REDUCTION(l4[i], l4[i+1u]), REDUCTION(l4[i+2u], l4[i+3u]));
    if (outLevels >= 5) {
        imageStore(mip_5, ivec2(gl_WorkGroupID.xy)*2 + ivec2(lid&1u, lid>>1), vec4(value));
    }
    if (outLevels >= 6 && lid == 0u) {
        for (uint j = 4u; j < 16u; j++) {
            value = REDUCTION(value, l4[j]);
        }
        imageStore(mip_6, ivec2(gl_WorkGroupID.xy), vec4(value));
    }
}
