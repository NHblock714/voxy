+void addRetryRequest(inout UnpackedNode node) {
+    if (!hasRequested(node)) {
+        enqueueRequestRaw(node, true);
+    } else if ((frameId & 15u) == 0u) {
+        // When a coarse fallback is visible, the original child request may still
+        // be in-flight. Re-submit a throttled request so the CPU side can kick
+        // any missing child mesh jobs again instead of leaving the parent coarse
+        // forever. Do not mark again; the node is already marked requested.
+        enqueueRequestRaw(node, false);
+    }
+}
