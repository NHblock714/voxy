+package me.cortex.voxy.commonImpl.compat;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.block.entity.BlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.chunk.LevelChunk;
+import net.neoforged.fml.ModList;
+import net.neoforged.neoforge.client.model.data.ModelData;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Compatibility bridge for Domum Ornamentum materially textured blocks.
+ *
+ * Domum stores the selected material textures on the block entity and exposes
+ * them through NeoForge ModelData. Voxy normally bakes one model per BlockState,
+ * so the software bakery sees only the fallback/placeholder model and the LOD
+ * becomes grey. This class captures the first ModelData seen for each Domum
+ * BlockState while chunks are ingested and reuses it when the state is baked.
+ *
+ * This is intentionally reflection-free at call sites and does not require a
+ * hard dependency on Domum Ornamentum; it only activates when that mod is loaded
+ * and the block entity class belongs to Domum.
+ */
+public final class DomumOrnamentumCompat {
+    private static final boolean LOADED = ModList.get().isLoaded("domum_ornamentum");
+    private static final String DOMUM_PACKAGE = "com.ldtteam.domumornamentum";
+    private static final Map<BlockState, ModelData> MODEL_DATA_BY_STATE = new ConcurrentHashMap<>();
+
+    private DomumOrnamentumCompat() {
+    }
+
+    public static void captureFromChunkSection(LevelChunk chunk, int sectionY) {
+        if (!LOADED || chunk == null) {
+            return;
+        }
+
+        int minY = sectionY << 4;
+        int maxY = minY + 15;
+
+        try {
+            for (BlockEntity blockEntity : chunk.getBlockEntities().values()) {
+                if (blockEntity == null || !isDomumBlockEntity(blockEntity)) {
+                    continue;
+                }
+
+                BlockPos pos = blockEntity.getBlockPos();
+                if (pos.getY() < minY || pos.getY() > maxY) {
+                    continue;
+                }
+
+                ModelData modelData = blockEntity.getModelData();
+                if (modelData == null || modelData == ModelData.EMPTY) {
+                    continue;
+                }
+
+                BlockState state = blockEntity.getBlockState();
+                if (state != null && !state.isAir()) {
+                    MODEL_DATA_BY_STATE.putIfAbsent(state, modelData);
+                }
+            }
+        } catch (Throwable ignored) {
+            // Keep chunk ingestion robust. If Domum changes internals, Voxy should
+            // fall back to the normal state-only bake instead of crashing.
+        }
+    }
+
+    public static ModelData getModelData(BlockState state) {
+        if (!LOADED || state == null) {
+            return ModelData.EMPTY;
+        }
+        return MODEL_DATA_BY_STATE.getOrDefault(state, ModelData.EMPTY);
+    }
+
+    private static boolean isDomumBlockEntity(BlockEntity blockEntity) {
+        String name = blockEntity.getClass().getName();
+        return name.startsWith(DOMUM_PACKAGE);
+    }
+}
